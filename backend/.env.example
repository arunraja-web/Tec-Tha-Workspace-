PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/company_workspace
JWT_SECRET=your_secure_jwt_secret_key
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7
NODE_ENV=development

# Initial Seed Users
ADMIN_INITIAL_EMAIL=admin@tectha.com
ADMIN_INITIAL_PASSWORD=Admin@123
EMPLOYEE_INITIAL_EMAIL=test@tectha.com
EMPLOYEE_INITIAL_PASSWORD=123456

# Email Settings for Password Recovery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=no-reply@companyworkspace.com
FRONTEND_URL=http://localhost:3000
